# Build stage
FROM docker.io/library/golang:1.25-alpine AS builder

# No apk install needed: the base image already ships ca-certificates, and
# module fetching goes through the Go module proxy rather than git.

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /bin/chitd ./cmd/chitd

# Runtime stage
FROM registry.access.redhat.com/ubi9-minimal:latest

RUN microdnf install -y shadow-utils && microdnf clean all
RUN groupadd -r chit && useradd -r -g chit -s /sbin/nologin chit

COPY --from=builder /bin/chitd /usr/local/bin/chitd
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=builder /src/auth /etc/chit/auth
ENV CHIT_COMMANDS_CUE_DIR=/etc/chit/auth

USER chit
EXPOSE 8065

ENTRYPOINT ["chitd"]
