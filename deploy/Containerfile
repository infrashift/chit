# Build stage
FROM docker.io/library/golang:1.25-alpine AS builder

# No apk install needed: the base image already ships ca-certificates, and
# module fetching goes through the Go module proxy rather than git.

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
# TWO HAND-MAINTAINED LISTS: every binary built here needs a matching COPY in
# the runtime stage below. A command added to one and not the other yields an
# image that starts and then fails at exec with "no such file or directory".
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /bin/chitd ./cmd/chitd
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /bin/chit-reconcile ./cmd/chit-reconcile

# Runtime stage
FROM registry.access.redhat.com/ubi9-minimal:latest

RUN microdnf install -y shadow-utils && microdnf clean all
RUN groupadd -r chit && useradd -r -g chit -s /sbin/nologin chit

COPY --from=builder /bin/chitd /usr/local/bin/chitd
# The one-shot reconciler that pushes auth/*.cue into Keto. It ships in the same
# image so the Nomad job can run it as a batch task against the same CUE the
# server loads, rather than a second image that could drift from it.
COPY --from=builder /bin/chit-reconcile /usr/local/bin/chit-reconcile
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=builder /src/auth /etc/chit/auth
ENV CHIT_COMMANDS_CUE_DIR=/etc/chit/auth

USER chit
EXPOSE 8065

ENTRYPOINT ["chitd"]
