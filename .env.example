# Copy to .env. `make run` sources .env with sh, so quote any value that
# contains spaces or JSON. chitd itself reads only its environment, never this
# file. Values are for the local `make kube-up` stack. chitd validates its
# settings at startup and reports every invalid one at once.

# Server
CHIT_LISTEN_ADDRESS=:8065
# Comma-separated CORS/WebSocket origin allowlist. "*" allows any origin and
# logs a warning (dev only). Empty allows no browser origin at all.
CHIT_ALLOWED_ORIGINS=*
# debug | info | warn | error
CHIT_LOG_LEVEL=info
# json | text
CHIT_LOG_FORMAT=json

# Database. Required by chitd; there is no default. chit-reconcile does not
# use it.
CHIT_DATABASE_URL=postgres://chit:chit@localhost:5432/chit?sslmode=disable
# Must be positive; idle must be between 0 and the open limit.
CHIT_DB_MAX_OPEN_CONN=25
CHIT_DB_MAX_IDLE_CONN=10

# Pub/Sub: pgnotify | nats (nats requires CHIT_NATS_URL)
CHIT_PUBSUB_BACKEND=pgnotify
CHIT_NATS_URL=nats://localhost:4222

# Ory
CHIT_TRUSTED_PROXY_HEADER=X-User-Id
# When set, requests must carry a matching X-Proxy-Secret header (injected by
# Oathkeeper's header mutator) before X-User-Id is trusted. Recommended in
# production so a directly-reachable backend cannot be impersonated.
CHIT_TRUSTED_PROXY_SECRET=
# Carries the OAuth2 client_id of a machine actor whose Hydra token Oathkeeper
# introspected. Takes precedence over CHIT_TRUSTED_PROXY_HEADER and is resolved
# against users.oauth_client_id — an unknown client is rejected, never
# provisioned into a new user.
CHIT_TRUSTED_CLIENT_HEADER=X-Client-Id
# Machine actors (agents and bots that authenticate with a Hydra
# client_credentials token), as a JSON array. chitd creates or updates each one
# at every boot (never deletes) and refuses to start if a declaration is
# invalid. actor_type is required: "agent" or "bot". roles is space-separated
# and defaults to "system_user". Empty declares none.
# Single-quote the value: `make run` sources this file with sh, which would
# otherwise strip the JSON's double quotes.
#CHIT_MACHINE_ACTORS='[{"client_id":"<hydra client id>","username":"claude-architect","display_name":"Claude Architect","roles":"system_user","actor_type":"agent"}]'
CHIT_MACHINE_ACTORS=
CHIT_KRATOS_ADMIN_URL=http://localhost:4434
CHIT_KETO_READ_URL=http://localhost:4466
CHIT_KETO_WRITE_URL=http://localhost:4467

# ZincSearch. Opt-in: chitd's default URL is empty, which makes search use
# SQL and runs no indexer. Set here because the kube stack runs ZincSearch.
CHIT_ZINCSEARCH_URL=http://localhost:4080
CHIT_ZINCSEARCH_USER=admin
# chitd's default is empty; "admin" matches the kube stack.
CHIT_ZINCSEARCH_PASSWORD=admin

# WebSocket (must be positive)
CHIT_WS_PING_INTERVAL=30s
CHIT_WS_WRITE_TIMEOUT=10s

# Cache (must be positive)
CHIT_CACHE_SIZE=20000
CHIT_CACHE_TTL=5m

# OpenAPI
CHIT_ENABLE_OPENAPI_VALIDATION=true

# MCP Agent (chit-mcp is an HTTP/WS client of chitd; CHIT_MCP_-prefixed).
# Same two authentication modes as chit-claude: set OAUTH_CLIENT_ID (with its
# secret and token URL) to go through Oathkeeper with a Hydra token, or
# AGENT_KRATOS_ID for dev. Set exactly one; both is a startup error.
# SERVER_URL: Oathkeeper (4455) for OAuth2, chitd (8065) for the Kratos ID.
CHIT_MCP_SERVER_URL=http://localhost:4455
CHIT_MCP_OAUTH_TOKEN_URL=http://localhost:4444/oauth2/token
CHIT_MCP_OAUTH_CLIENT_ID=
CHIT_MCP_OAUTH_CLIENT_SECRET=
CHIT_MCP_OAUTH_SCOPES="chit:read chit:write"
CHIT_MCP_OAUTH_AUDIENCE=chit
CHIT_MCP_AGENT_KRATOS_ID=
CHIT_MCP_PROXY_SECRET=

# Slash Commands
CHIT_COMMANDS_CUE_DIR=auth
# Empty or "-" logs to stderr; so does a path chitd cannot create or open.
CHIT_AUDIT_LOG_PATH=/var/log/chit/audit.log
# When true, WEBHOOK_URL is required and the worker count, queue size and
# timeout must be positive.
CHIT_WEBHOOK_ENABLED=false
CHIT_WEBHOOK_URL=
CHIT_WEBHOOK_SECRET=
CHIT_WEBHOOK_WORKER_COUNT=4
CHIT_WEBHOOK_QUEUE_SIZE=1024
CHIT_WEBHOOK_TIMEOUT_SEC=10

# chit-claude bridge (headless Claude Code <-> Chit)
# The bridge is a separate process; it talks to chitd over HTTP/WebSocket and
# shells out to the `claude` CLI. Keep ANTHROPIC_API_KEY OUT of its
# environment so runs bill against your Claude subscription (OAuth), not the
# pay-per-token API.
# OAuth2 mode (preferred): point at Oathkeeper, which introspects the token.
# Trusted-proxy mode: point directly at chitd (http://localhost:8065).
#CHIT_CLAUDE_SERVER_URL=http://localhost:4455
#
# --- Authentication: configure EITHER the OAuth2 block OR the Kratos block ---
#
# OAuth2 client credentials issued by Ory Hydra. Setting OAUTH_CLIENT_ID
# switches the bridge to token auth; the agent's identity then comes from the
# client binding (users.oauth_client_id, declared in CHIT_MACHINE_ACTORS)
# rather than AGENT_KRATOS_ID.
#CHIT_CLAUDE_OAUTH_TOKEN_URL=http://localhost:4444/oauth2/token
#CHIT_CLAUDE_OAUTH_CLIENT_ID=
#CHIT_CLAUDE_OAUTH_CLIENT_SECRET=
# Space-separated. chit:read to listen and fetch, chit:write to post.
#CHIT_CLAUDE_OAUTH_SCOPES="chit:read chit:write"
# Names the application the token is valid for; Oathkeeper enforces it.
#CHIT_CLAUDE_OAUTH_AUDIENCE=chit
#
# Kratos ID of the agent user (e.g. seed-uat's chit-agent). Dev/test only —
# this asserts an identity rather than proving one.
#CHIT_CLAUDE_AGENT_KRATOS_ID=
# Must match CHIT_TRUSTED_PROXY_SECRET when set on chitd
#CHIT_CLAUDE_PROXY_SECRET=
# Comma-separated channel IDs the bridge serves
#CHIT_CLAUDE_CHANNELS=
# Only respond when the agent is @mentioned (default false)
#CHIT_CLAUDE_REQUIRE_MENTION=false
# Answer posts written by other agents/bots (default false — this is the loop
# guard that lets several personas share one channel). When true, an agent
# post is answered only if it names this agent directly (@all does not count)
# and the thread is under MAX_AGENT_HOPS.
#CHIT_CLAUDE_REPLY_TO_AGENTS=false
# Max consecutive agent->agent turns before a chain stops; a human post resets
# the count. Only consulted when REPLY_TO_AGENTS=true.
#CHIT_CLAUDE_MAX_AGENT_HOPS=2
#CHIT_CLAUDE_CLAUDE_BIN=claude
# Directory claude runs in (the project it works on) — required.
# Give each persona its own workdir/worktree once write tools are allowed.
#CHIT_CLAUDE_WORKDIR=
# Model this persona runs on, e.g. claude-fable-5 or claude-sonnet-5.
# Empty (default) leaves the claude CLI's own default in place.
#CHIT_CLAUDE_MODEL=
#CHIT_CLAUDE_PERMISSION_MODE=dontAsk
#CHIT_CLAUDE_ALLOWED_TOOLS=Read,Grep,Glob
#CHIT_CLAUDE_APPEND_SYSTEM_PROMPT=
#CHIT_CLAUDE_RUN_TIMEOUT=30m
# Context window assumed for the "context ~N%" footer estimate
#CHIT_CLAUDE_CONTEXT_WINDOW=200000
